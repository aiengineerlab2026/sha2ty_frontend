NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only: where the /api/backend proxy forwards to (falls back to NEXT_PUBLIC_API_BASE_URL).
# The browser never calls the backend directly any more; sessions are httpOnly cookies.
API_BASE_URL=http://localhost:8000

# Optional: "Pick on map" for vendor locations (Maps JavaScript API + Geocoding API enabled).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
