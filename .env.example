# The FastAPI backend the browser calls directly (every API is there). Production: its public URL, e.g.
# https://api.sha2ty.net, with this site listed in the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: "Pick on map" for vendor locations (Maps JavaScript API + Geocoding API enabled).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
